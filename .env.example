# ── Lead Assistant (Phase 3) ────────────────────────────────
# Template only — copy to .env.local and fill in real values there.
# Next.js loads .env.local (git-ignored), NOT this file. Never put real
# secrets in .env.example.
#
# All optional in the demo: with none set, the chat widget uses a graceful
# scripted fallback and leads are logged to the server console.

# Claude API — powers the lead assistant's free-text replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase — stores captured leads in a `leads` table
# (columns: email, name, inquiry_type, detail, session_id, created_at).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails the coach when a lead is captured.
RESEND_API_KEY=
# Where new-lead alerts are delivered.
LEAD_NOTIFY_EMAIL=
# Sender address. Use onboarding@resend.dev (delivers only to your Resend
# account email) until you verify your domain, then e.g. assistant@yourdomain.com.
LEAD_FROM_EMAIL=
